# MNEMOSYNE — environment template
# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Server (required) ---
# Postgres connection string for the linked database. For the Supabase
# pooler use the form (note the <ref> in the username; port 6543):
#   postgresql://<ROLE>.<REF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# The app connects with TLS and trusts the pooler certificate
# (ssl.rejectUnauthorized=false); do NOT add ?sslmode=require, which would
# force full cert verification and fail on the pooler chain.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ─── Supabase Auth (hosted) ───────────────────────────────────────────
# Sign-in/sign-up/session now route through Supabase Auth. With these set,
# auth works without relying on DATABASE_URL at runtime. Publishable/anon
# keys only — never the service-role key.
# Browser (Vite/Next client):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server:
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy alias (optional):
SUPABASE_ANON_KEY=
# Public base URL used in verification/reset emails (no trailing slash).
APP_URL=http://localhost:3000
# Session lifetime in days (default 30).
SESSION_TTL_DAYS=30

# --- Scheduled processing (Parts 4/8) — secret guarding cron/trigger routes ---
# Any non-empty value enables the protected /api/cron/* endpoints. Set a
# unique random value per environment.
INTELLIGENCE_CRON_SECRET=
INTEGRATIONS_CRON_SECRET=

# --- Email (optional) ---
# When SMTP_* are unset, email links are logged to the dev console instead of sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Memory engine (Part 3) — optional provider config ---
# When AI/embedding providers are not configured, the engine preserves
# ingestions and records retryable failures — it never fabricates memories
# or embeddings. Set AI_PROVIDER=openai and OPENAI_API_KEY to enable.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Job queue tuning (defaults shown).
JOB_CONCURRENCY=3
JOB_TIMEOUT_MS=60000
JOB_MAX_ATTEMPTS=5
INGESTION_MAX_BYTES=500000

# --- Conversational AI (Part 6) — optional provider config ---
# When no chat provider is configured, the chat engine still answers using a
# deterministic evidence-grounded path (retrieved memories ranked) — it never
# fabricates. Set CHAT_PROVIDER=openai and reuse OPENAI_API_KEY to enable
# generative answers. Model selection is cfg-model-first with escalation.
CHAT_PROVIDER=
CHAT_MODEL_SMALL=gpt-4o-mini
CHAT_MODEL_LARGE=gpt-4o
# Server-only secret (32+ random bytes) used to encrypt BYOK provider keys at
# rest. If unset, user-provided keys are disabled (BYOK off).
CHAT_KEY_ENCRYPTION_SECRET=

# --- Agent bridge (Part 7) — server-only ---
# Secret (32+ random bytes) used to encrypt agent/webhook secrets at rest.
# Falls back to CHAT_KEY_ENCRYPTION_SECRET when unset. If both are unset,
# webhook subscriptions are disabled. No agent credential is ever stored in
# plaintext: API tokens are SHA-256 hashed and shown once at issuance.
AGENT_BRIDGE_ENCRYPTION_SECRET=
# Per-agent API rate limit (requests/minute) and max memories in a context package.
AGENT_API_RATE_LIMIT=120
AGENT_CONTEXT_MAX_MEMORIES=40

# --- External integrations OAuth (Part 8, optional) ---
# Each provider's OAuth client ID/secret. When a provider's pair is unset,
# that connector is shown as not-configured. Least-privilege scopes are
# requested per provider. CONNECTOR_ENCRYPTION_SECRET (server-only, 32+ random
# bytes) is required to store OAuth tokens at rest; if unset, OAuth
# connections are disabled entirely.
CONNECTOR_ENCRYPTION_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
DROPBOX_OAUTH_APP_KEY=
DROPBOX_OAUTH_APP_SECRET=
# Unset = OneDrive OAuth connection unavailable (shown as not-configured).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Backup scripts (shell env, scripts/backup.sh) ---
# Only used by scripts/backup.sh; not read by the application.
BACKUP_DIR=./backups
BACKUP_RETENTION=14

# --- Public (safe to expose) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
