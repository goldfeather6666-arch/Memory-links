# MNEMOSYNE — environment template
# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Server (required) ---
# Postgres connection string for the linked database.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Public base URL used in verification/reset emails (no trailing slash).
APP_URL=http://localhost:3000
# Session lifetime in days (default 30).
SESSION_TTL_DAYS=30

# --- Email (optional) ---
# When SMTP_* are unset, email links are logged to the dev console instead of sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Public (safe to expose) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
